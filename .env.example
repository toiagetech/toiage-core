APP_NAME=ToiageCore
APP_ENV=development
# Path prefix the API is served under (run with: uvicorn app.main:root_app).
# Default: /toiage-core  -> http://localhost:8000/toiage-core/docs
# Set to empty (API_PREFIX=) to serve at the root: http://localhost:8000/docs
API_PREFIX=/toiage-core
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/toiage
# LLM provider - backend decides which provider to use (not the frontend)
# Options:
#   mock       → static canned response (no API key, no DB)
#   openrouter  → real AI model via OpenRouter API (costs money)
#   db          → fetch existing story from database (saves API cost, falls back to LLM if no match)
#   deepseek    → real AI model via DeepSeek API
#   openai/gemini/ollama → optional providers (require optional deps)
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MODEL=google/gemini-2.0-flash-001
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
MAX_UPLOAD_SIZE_MB=10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat